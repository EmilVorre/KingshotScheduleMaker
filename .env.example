# Copy to .env and fill in your values. Never commit .env to git.
# On the server: cp .env.example .env && nano .env

# Docker prod (docker-compose.prod.yml): owner/repo from GitHub
# GITHUB_REPOSITORY=owner/repo
# IMAGE_TAG=v1.0.0

# OAuth - Discord (see docs/OAUTH_SETUP.md)
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=

# OAuth - Google
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# Production URLs (set for OAuth redirects)
BASE_URL=https://ks.vorre.dev
FRONTEND_URL=https://ks.vorre.dev
