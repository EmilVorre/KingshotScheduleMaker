# Copy to .env and fill in your values. Never commit .env to git.
# On the server: cp .env.example .env && nano .env

# OAuth - Discord (see docs/OAUTH_SETUP.md)
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=

# OAuth - Google
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# Production URLs (set for OAuth redirects)
BASE_URL=https://prep.vorre.dev
FRONTEND_URL=https://prep.vorre.dev
